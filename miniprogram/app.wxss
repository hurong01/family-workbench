page{min-height:100%;background:#f6f4ee;color:#262721;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx;box-sizing:border-box}.card{background:#fffefb;border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(58,54,43,.06)}.muted{color:#8a8a84}.section-title{font-size:32rpx;font-weight:700;margin:38rpx 0 20rpx}.primary-btn{background:#e07a45!important;color:white!important;border-radius:999rpx;font-weight:600}.primary-btn::after{border:0}

<view class="page"><view class="month-row"><picker mode="date" fields="month" value="{{month}}" bindchange="bindMonth"><view class="month">{{month}} ▾</view></picker><view class="muted">共 {{expenses.length}} 笔</view></view><view wx:if="{{loading}}" class="empty">正在加载账单…</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button size="mini" bindtap="load">重新加载</button></view><block wx:else><view class="bill-summary card"><view class="muted">本月总支出</view><view class="bill-total">¥{{total}}</view><view class="divider"></view><view class="chart-title">分类占比</view><view wx:if="{{!groups.length}}" class="muted">本月还没有支出</view><view wx:for="{{groups}}" wx:key="name" class="bar-row"><view class="bar-label"><text>{{item.name}}</text><text>¥{{item.amount}}</text></view><view class="bar"><view style="width:{{item.percent}}%"></view></view></view></view><view class="section-title">全部流水</view><view wx:if="{{!expenses.length}}" class="empty card">这个月还没有账目，去“记账”添加第一笔吧。</view><view wx:else class="card bill-list"><view wx:for="{{expenses}}" wx:key="_id" class="bill-row" data-item="{{item}}" bindtap="manage"><view class="bill-icon">{{item.icon||'账'}}</view><view class="bill-main"><view>{{item.category}}</view><view class="muted small">{{item.payerName}} · {{item.paidAtText}}</view></view><view><view class="bill-price">-¥{{item.amount}}</view><view wx:if="{{item.canEdit}}" class="edit-tip">点按管理</view></view></view></view></block></view>

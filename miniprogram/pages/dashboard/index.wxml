<view class="page dashboard"><view wx:if="{{loading}}" class="state">正在加载家庭账本…</view><view wx:elif="{{error}}" class="state"><view>{{error}}</view><button size="mini" bindtap="load">重新加载</button></view><block wx:else>
  <view class="hero"><view><view class="eyebrow">{{dashboard.familyName}} · {{dashboard.monthLabel}}</view><view class="greeting">一起把这个家照顾好</view></view><view class="avatars"><view wx:for="{{dashboard.members}}" wx:key="*this" class="avatar">{{item}}</view></view></view>
  <view class="summary card"><view class="muted">本月家庭开销</view><view class="amount"><text>¥</text>{{dashboard.total}}</view><view class="trend">{{dashboard.compareText}}</view><view class="summary-footer"><text>家庭预算 ¥{{dashboard.budget}}</text><text>剩余 ¥{{dashboard.remaining}}</text></view><view class="progress"><view style="width:{{dashboard.budgetPercent}}%"></view></view></view>
  <view class="section-title row-title"><text>待缴费用</text><text class="link" bindtap="openBills">查看全部</text></view>
  <scroll-view scroll-x class="reminder-scroll"><view class="reminder-row"><view wx:for="{{dashboard.reminders}}" wx:key="name" class="reminder card"><view class="reminder-icon">费</view><view><view class="reminder-name">{{item.name}}</view><view class="muted small">{{item.status}}</view></view><view class="reminder-amount">{{item.amount}}</view></view></view></scroll-view>
  <view class="section-title">快捷记账</view><view class="category-grid card"><view wx:for="{{categories}}" wx:key="name" class="category" data-category="{{item.name}}" bindtap="addExpense"><view class="category-icon" style="background:{{item.color}}">{{item.icon}}</view><text>{{item.name}}</text></view></view>
  <view class="section-title row-title"><text>最近流水</text><text class="link" bindtap="openBills">月度账单</text></view><view class="list card"><view wx:for="{{dashboard.recent}}" wx:key="_id" class="expense-row"><view class="expense-icon" style="background:{{item.color}}">{{item.icon}}</view><view class="expense-main"><view>{{item.category}}</view><view class="muted small">{{item.payerName}} 支付 · {{item.paidAtText}}</view></view><view class="expense-price">-¥{{item.amount}}</view></view></view>
  <button class="primary-btn add-button" bindtap="addExpense">＋ 记一笔</button>
</block></view>

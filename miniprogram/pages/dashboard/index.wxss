.dashboard{padding-bottom:160rpx}.hero{display:flex;justify-content:space-between;align-items:center;padding:14rpx 4rpx 30rpx}.eyebrow{color:#74746e;font-size:26rpx}.greeting{font-size:38rpx;font-weight:750;margin-top:8rpx}.avatars{display:flex}.avatar{width:56rpx;height:56rpx;margin-left:-12rpx;border-radius:50%;color:white;background:#668574;border:4rpx solid #f6f4ee;display:flex;align-items:center;justify-content:center;font-size:24rpx}.avatar:nth-child(2n){background:#db8b5f}.summary{padding:34rpx;background:linear-gradient(140deg,#263d34,#426855);color:white}.summary .muted{color:rgba(255,255,255,.7)}.amount{font-size:72rpx;font-weight:750;margin:12rpx 0}.amount text{font-size:38rpx;margin-right:8rpx}.trend{display:inline-block;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.12);font-size:24rpx}.summary-footer{display:flex;justify-content:space-between;margin-top:32rpx;font-size:24rpx;color:rgba(255,255,255,.78)}.progress{height:10rpx;background:rgba(255,255,255,.18);border-radius:10rpx;margin-top:14rpx;overflow:hidden}.progress view{height:100%;background:#efb27f}.row-title{display:flex;justify-content:space-between}.link{color:#d66e3d;font-size:25rpx;font-weight:400}.reminder-scroll{margin:0 -28rpx;width:calc(100% + 56rpx)}.reminder-row{display:flex;gap:20rpx;padding:0 28rpx 10rpx;width:max-content}.reminder{width:490rpx;padding:26rpx;box-sizing:border-box;display:flex;align-items:center}.reminder-icon,.expense-icon{width:72rpx;height:72rpx;background:#f5e8d9;border-radius:22rpx;display:flex;justify-content:center;align-items:center;margin-right:20rpx;font-weight:700}.reminder-name{font-weight:650;margin-bottom:8rpx}.reminder-amount{margin-left:auto;font-weight:700}.small{font-size:23rpx}.category-grid{padding:28rpx 16rpx 16rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:26rpx 10rpx}.category{display:flex;flex-direction:column;align-items:center;gap:12rpx;font-size:25rpx}.category-icon{width:82rpx;height:82rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;font-weight:700}.list{padding:0 28rpx}.expense-row{display:flex;align-items:center;min-height:126rpx;border-bottom:1rpx solid #eeeae1}.expense-row:last-child{border-bottom:0}.expense-main{flex:1;line-height:1.7}.expense-price{font-weight:700}.add-button{position:fixed;left:110rpx;right:110rpx;bottom:130rpx;z-index:10;box-shadow:0 12rpx 26rpx rgba(224,122,69,.3)}

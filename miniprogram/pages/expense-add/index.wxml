<view class="page form-page"><view class="form-intro"><view class="form-title">{{expenseId?'编辑家庭开销':'记一笔家庭开销'}}</view><view class="muted">每一笔认真记录，都是家的日常</view></view><view wx:if="{{loading}}" class="muted loading">正在加载家庭成员…</view><block wx:else><view class="amount-box card"><text>¥</text><input type="digit" placeholder="0.00" value="{{amount}}" data-field="amount" bindinput="bindField"/></view><view class="form card"><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="bindCategory"><view class="form-row"><text>费用分类</text><text>{{categories[categoryIndex]}} 〉</text></view></picker><picker range="{{members}}" value="{{payerIndex}}" bindchange="bindPayer"><view class="form-row"><text>付款成员</text><text>{{members[payerIndex]}} 〉</text></view></picker><picker mode="date" value="{{date}}" bindchange="bindDate"><view class="form-row"><text>支付日期</text><text>{{date}} 〉</text></view></picker><view class="form-row note-row"><text>备注</text><input placeholder="选填，如：客厅灯泡" value="{{note}}" data-field="note" bindinput="bindField"/></view></view><button class="primary-btn submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{expenseId?'保存修改':'保存账目'}}</button></block></view>

<view class="page"><view wx:if="{{loading}}" class="muted">正在加载家庭成员…</view><view wx:elif="{{error}}"><text>{{error}}</text><button size="mini" bindtap="load">重试</button></view><block wx:else><view class="family-card card"><view class="home-mark">家</view><view><view class="family-name">{{family.name}}</view><view class="muted">{{family.address}} · {{family.room}}</view></view></view><button wx:if="{{role==='admin'}}" class="primary-btn invite" bindtap="invite">＋ 生成邀请码</button><button wx:if="{{inviteCode}}" open-type="share" class="share-btn">分享给微信好友</button><view class="section-title">家庭成员 · {{members.length}}</view><view class="card member-list"><view wx:for="{{members}}" wx:key="name" class="member-row"><view class="member-avatar">{{item.name}}</view><view class="member-name">{{item.name}}</view><view class="role {{item.role==='admin'?'admin':''}}">{{item.role==='admin'?'管理员':'成员'}}</view></view></view><view class="privacy card"><view class="privacy-title">隐私提示</view><view class="muted">家庭地址和账目信息仅家庭成员可见。邀请新成员前，请确认对方身份。</view></view></block></view>

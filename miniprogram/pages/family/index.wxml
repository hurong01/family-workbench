<view class="page"><view wx:if="{{loading}}" class="muted">正在加载家庭成员…</view><view wx:elif="{{error}}"><text>{{error}}</text><button size="mini" bindtap="load">重试</button></view><block wx:else><view class="family-card card"><view class="home-mark">家</view><view><view class="family-name">{{family.name}}</view><view class="muted">{{family.address}} · {{family.room}}</view><view class="muted">月预算 ¥{{family.budget}}</view></view></view><button wx:if="{{role==='admin'}}" class="primary-btn invite" bindtap="invite">＋ 生成邀请码</button><button wx:if="{{inviteCode}}" open-type="share" class="share-btn">分享给微信好友</button><view wx:if="{{role==='admin'}}" class="section-title">家庭管理</view><view wx:if="{{role==='admin'}}" class="card member-list"><view class="member-row" bindtap="updateBudget"><view class="member-name">修改家庭预算</view><text>〉</text></view><view class="member-row" bindtap="recurring"><view class="member-name">固定费用提醒</view><text>〉</text></view><view class="member-row" bindtap="revoke"><view class="member-name">撤销未使用邀请码</view><text>〉</text></view></view><view class="section-title">家庭成员 · {{members.length}}</view><view class="card member-list"><view wx:for="{{members}}" wx:key="memberId" class="member-row" data-member="{{item}}" bindtap="transfer"><view class="member-avatar">{{item.name}}</view><view class="member-name">{{item.name}}</view><view class="role {{item.role==='admin'?'admin':''}}">{{item.role==='admin'?'管理员':'成员'}}</view><text wx:if="{{role==='admin'&&item.role!=='admin'}}">〉</text></view></view><view class="privacy card"><view class="privacy-title">隐私提示</view><view class="muted">家庭地址和账目信息仅家庭成员可见。点击普通成员可转移管理员。</view></view><button wx:if="{{role==='admin'}}" type="warn" plain style="margin-top:40rpx" bindtap="deleteFamily">删除整个家庭</button></block></view>

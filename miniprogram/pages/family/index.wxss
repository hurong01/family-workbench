.family-card{padding:34rpx;display:flex;align-items:center}.home-mark{width:104rpx;height:104rpx;border-radius:32rpx;background:#e7eee8;color:#426855;display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:750;margin-right:24rpx}.family-name{font-size:38rpx;font-weight:750;margin-bottom:10rpx}.invite{margin-top:28rpx}.share-btn{margin-top:18rpx;border-radius:999rpx;background:#fff;color:#426855}.member-list{padding:0 30rpx}.member-row{display:flex;align-items:center;min-height:126rpx;border-bottom:1rpx solid #eeeae1}.member-row:last-child{border:0}.member-avatar{width:72rpx;height:72rpx;border-radius:50%;background:#577765;color:white;display:flex;align-items:center;justify-content:center;margin-right:22rpx}.member-name{flex:1;font-weight:650}.role{font-size:23rpx;color:#888;background:#f1f0eb;padding:8rpx 16rpx;border-radius:999rpx}.role.admin{color:#b45b32;background:#f8e7dc}.privacy{margin-top:30rpx;padding:28rpx;line-height:1.7;font-size:25rpx}.privacy-title{font-weight:700;margin-bottom:8rpx}

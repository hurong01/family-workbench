<view class="page onboarding"><view class="brand">家</view><view class="title">欢迎使用家庭工作台</view><view class="muted subtitle">和家人一起，把每一笔生活开销记清楚</view><view class="tabs"><view class="tab {{mode==='create'?'active':''}}" data-mode="create" bindtap="setMode">创建家庭</view><view class="tab {{mode==='join'?'active':''}}" data-mode="join" bindtap="setMode">加入家庭</view></view><view class="card form" wx:if="{{mode==='create'}}"><view class="field"><text>家庭名称</text><input value="{{name}}" data-field="name" bindinput="input" placeholder="例如：璀璨之家"/></view><view class="field"><text>小区</text><input value="{{address}}" data-field="address" bindinput="input" placeholder="选填"/></view><view class="field"><text>房号</text><input value="{{room}}" data-field="room" bindinput="input" placeholder="选填"/></view></view><view class="card form" wx:else><view class="field"><text>家庭邀请码</text><input value="{{inviteCode}}" data-field="inviteCode" bindinput="input" maxlength="12" placeholder="请输入邀请码"/></view></view><view class="card form member"><view class="field"><text>你的称呼</text><input value="{{memberName}}" data-field="memberName" bindinput="input" placeholder="例如：容" maxlength="12"/></view></view><checkbox-group bindchange="toggleAgree"><label class="agree"><checkbox value="yes" checked="{{agreed}}" color="#E07A45"/><text>我已阅读并同意</text><text class="privacy-link" catchtap="openPrivacy">《隐私说明》</text></label></checkbox-group><button class="primary-btn submit" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">{{mode==='create'?'创建家庭':'加入家庭'}}</button></view>

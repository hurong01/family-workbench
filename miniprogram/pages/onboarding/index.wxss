.onboarding{padding-top:60rpx}.brand{width:110rpx;height:110rpx;margin:auto;border-radius:34rpx;background:#426855;color:white;display:flex;align-items:center;justify-content:center;font-size:48rpx;font-weight:700}.title{text-align:center;font-size:42rpx;font-weight:750;margin-top:30rpx}.subtitle{text-align:center;margin-top:12rpx}.tabs{display:flex;background:#ebe8df;border-radius:999rpx;padding:8rpx;margin:46rpx 40rpx 24rpx}.tab{flex:1;text-align:center;padding:18rpx;border-radius:999rpx;color:#777}.tab.active{background:white;color:#262721;font-weight:700}.form{padding:0 30rpx}.member{margin-top:22rpx}.field{min-height:112rpx;display:flex;align-items:center;border-bottom:1rpx solid #eeeae1}.field:last-child{border:0}.field text{width:180rpx}.field input{flex:1;text-align:right}.agree{display:flex;align-items:center;justify-content:center;margin:34rpx 0;font-size:24rpx;color:#777}.agree checkbox{transform:scale(.8)}.privacy-link{color:#d66e3d}.submit{margin:0 30rpx}

.profile{display:flex;align-items:center;padding:36rpx}.profile-avatar{width:112rpx;height:112rpx;border-radius:50%;background:#426855;color:white;display:flex;align-items:center;justify-content:center;font-size:42rpx;margin-right:26rpx}.profile-name{font-size:36rpx;font-weight:750;margin-bottom:10rpx}.menu{padding:0 30rpx}.menu-row{height:112rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eeeae1}.menu-row:last-child{border:0}.menu-row text:last-child{color:#aaa}.version{text-align:center;margin-top:60rpx;font-size:24rpx}

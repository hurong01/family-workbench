<view class="page"><view class="card form"><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="bindCategory"><view class="row"><text>费用分类</text><text>{{categories[categoryIndex]}} 〉</text></view></picker><view class="row"><text>预计金额</text><input type="digit" value="{{amount}}" data-field="amount" bindinput="input" placeholder="0.00"/></view><view class="row"><text>每月提醒日</text><input type="number" value="{{day}}" data-field="day" bindinput="input" maxlength="2" placeholder="1-28"/></view></view><button class="primary-btn add" bindtap="add">添加固定费用</button><view class="section-title">现有提醒</view><view wx:if="{{loading}}" class="muted center">正在加载…</view><view wx:elif="{{!items.length}}" class="card empty">还没有固定费用提醒</view><view wx:else class="card list"><view wx:for="{{items}}" wx:key="id" class="item"><view><view class="name">{{item.category}}</view><view class="muted">每月 {{item.day}} 日提醒</view></view><view class="price">¥{{item.amount}}</view><button size="mini" data-item="{{item}}" bindtap="remove">删除</button></view></view></view>
